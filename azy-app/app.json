{
  "expo": {
    "name": "Azy",
    "slug": "azy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "azy",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#152238"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "يستخدم Azy الكاميرا لتصوير مستنداتك وتحويلها إلى PDF."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#152238"
      },
      "package": "com.azy.app",
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم Azy الكاميرا لتصوير مستنداتك وتحويلها إلى PDF."
        }
      ]
    ]
  }
}
